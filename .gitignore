# Scanned districts hold a repository's structure; a private one stays off the remote.
public/city/districts/*.js
# The one exception: this repository's own scan, so the deployed site has a project to enter.
!public/city/districts/index.js
!public/city/districts/kopicode.js
.DS_Store
# public/city/analysis.js is committed so the deployed site shows it. It names the projects it
# covers: before committing a new one, check it names no private repository.
